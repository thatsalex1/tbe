{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": null,
  "installCommand": "echo 'No install needed'",
  "env": {
    "VERCEL_ANALYTICS_ID": ""
  },
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
